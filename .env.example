# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun:  cp .env.example .env
# ".env" GitHub'a gönderilmez (.gitignore).

# SQL Server 'sa' şifresi (en az 8 karakter; büyük/küçük harf ve rakam içermeli)
SA_PASSWORD=

# JWT imzalama anahtarı (en az 32 karakter, rastgele)
JWT_ANAHTAR=

# İlk açılışta oluşturulacak admin@filo.com kullanıcısının şifresi
ADMIN_SIFRE=
